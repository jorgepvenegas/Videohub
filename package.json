{
  "name": "videohub",
  "version": "0.1.0",
  "private": true,
  "description": "Local cross-platform review studio and protected render queue for videos written as code by Claude Code or OpenCode.",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "video",
    "motion-graphics",
    "render-queue",
    "canvas",
    "puppeteer",
    "ffmpeg",
    "review",
    "linux",
    "macos",
    "opencode"
  ],
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "main": "server/hub.ts",
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "start": "node server/hub.ts",
    "mcp": "node server/mcp.ts",
    "test": "node scripts/test.ts",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c oxlintrc.json",
    "format": "oxfmt --config oxfmtrc.json --no-error-on-unmatched-pattern '{server,scripts,ui,engine-hooks,templates,examples}/**/*.{js,mjs,ts}' '*.ts'",
    "format:check": "oxfmt --config oxfmtrc.json --no-error-on-unmatched-pattern '{server,scripts,ui,engine-hooks,templates,examples}/**/*.{js,mjs,ts}' '*.ts' --check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "puppeteer-core": "^25.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
